rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsRequestData() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingData() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownerUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    function billingFields() {
      return [
        'subscriptionTier',
        'planId',
        'entitlementSource',
        'subscriptionSource',
        'subscriptionStatus',
        'subscriptionExpiresAt',
        'currentPeriodEnd',
        'cloudStorageLimitBytes',
        'revenueCatEventType',
        'revenueCatProductId',
        'revenueCatEntitlementIds',
        'revenueCatPlanId',
        'revenueCatSubscriptionStatus',
        'revenueCatExpiresAt',
        'revenueCatEventTimestampMs',
        'adminGrantPlanId',
        'adminGrantExpiresAt',
        'adminGrantGrantedBy',
        'adminGrantGrantedAt',
        'gumroadLicenseKey',
        'patreonTierName'
      ];
    }

    function storageMeterFields() {
      return [
        'storageUsedBytes'
      ];
    }

    function hasOnlyFreeBillingDefaults() {
      return (!('subscriptionTier' in request.resource.data) ||
          request.resource.data.subscriptionTier == 0) &&
        (!('planId' in request.resource.data) ||
          request.resource.data.planId == 'free') &&
        (!('cloudStorageLimitBytes' in request.resource.data) ||
          request.resource.data.cloudStorageLimitBytes == 5 * 1024 * 1024) &&
        (!('subscriptionExpiresAt' in request.resource.data) ||
          request.resource.data.subscriptionExpiresAt == null) &&
        (!('currentPeriodEnd' in request.resource.data) ||
          request.resource.data.currentPeriodEnd == null) &&
        !request.resource.data.keys().hasAny([
          'entitlementSource',
          'subscriptionSource',
          'subscriptionStatus',
          'revenueCatEventType',
          'revenueCatProductId',
          'revenueCatEntitlementIds',
          'revenueCatPlanId',
          'revenueCatSubscriptionStatus',
          'revenueCatExpiresAt',
          'revenueCatEventTimestampMs',
          'adminGrantPlanId',
          'adminGrantExpiresAt',
          'adminGrantGrantedBy',
          'adminGrantGrantedAt',
          'gumroadLicenseKey',
          'patreonTierName'
        ]);
    }

    function billingUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(billingFields());
    }

    function storageMeterUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(storageMeterFields());
    }

    // User profile document
    match /users/{userId} {
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        hasOnlyFreeBillingDefaults();
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() &&
        request.auth.uid == userId &&
        billingUnchanged() &&
        storageMeterUnchanged();

      // Nested app settings
      match /settings/{settingId} {
        allow create, read, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // User-owned entities with `userId` field
    match /notes/{docId} {
      allow create: if ownsRequestData();
      allow read: if ownsExistingData();
      allow update: if ownsExistingData() && ownerUnchanged();
      allow delete: if ownsExistingData();
    }

    match /folders/{docId} {
      allow create: if ownsRequestData();
      // Transitional support for legacy docs missing `userId`.
      // This allows authenticated clients to read legacy docs and "claim" them
      // by writing their own uid once. After migration, normal owner rules apply.
      allow read: if ownsExistingData() || (isSignedIn() && !(resource.data.userId is string));
      allow update: if (ownsExistingData() && ownerUnchanged()) ||
          (isSignedIn() &&
            !(resource.data.userId is string) &&
            request.resource.data.userId == request.auth.uid);
      allow delete: if ownsExistingData();
    }

    match /calendar_events/{docId} {
      allow create: if ownsRequestData();
      allow read: if ownsExistingData();
      allow update: if ownsExistingData() && ownerUnchanged();
      allow delete: if ownsExistingData();
    }

    match /homework/{docId} {
      allow create: if ownsRequestData();
      allow read: if ownsExistingData();
      allow update: if ownsExistingData() && ownerUnchanged();
      allow delete: if ownsExistingData();
    }

    match /timetable_entries/{docId} {
      allow create: if ownsRequestData();
      allow read: if ownsExistingData();
      allow update: if ownsExistingData() && ownerUnchanged();
      allow delete: if ownsExistingData();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
