<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/typesync_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/typesync_widget_background"
    android:padding="10dp">

    <ImageView
        android:id="@+id/typesync_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/typesync_widget_content_description"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/typesync_widget_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/typesync_widget_placeholder_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/typesync_widget_placeholder_title"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/typesync_widget_placeholder_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/typesync_widget_placeholder_subtitle"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
