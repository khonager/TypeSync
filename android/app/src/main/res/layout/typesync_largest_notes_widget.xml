<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/typesync_notes_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/typesync_widget_background"
    android:padding="6dp">

    <ImageView
        android:id="@+id/typesync_notes_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="TypeSync largest notes widget"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="#DD1C1C1E"
        android:orientation="horizontal">
        <TextView android:id="@+id/typesync_metric_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="7dp" android:paddingVertical="4dp" android:text="Size" android:textColor="#FFFFFFFF" android:textSize="11sp" />
        <TextView android:id="@+id/typesync_metric_characters" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="7dp" android:paddingVertical="4dp" android:text="Chars" android:textColor="#FFFFFFFF" android:textSize="11sp" />
        <TextView android:id="@+id/typesync_metric_lines" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="7dp" android:paddingVertical="4dp" android:text="Lines" android:textColor="#FFFFFFFF" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
